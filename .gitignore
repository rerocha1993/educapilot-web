# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example
# .env.production só tem a URL pública da API (NEXT_PUBLIC_*, que acaba embutida
# no bundle do cliente de qualquer jeito — não é segredo). Versionado de propósito:
# sem ele, um clone novo compila apontando para o localhost do .env.local e o
# deploy quebra silenciosamente.
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
